{
  "name": "@shikshit/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Typed API client, Zod schemas and error helpers generated from backend/api/openapi. Shared by web and mobile.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../backend/api/openapi/openapi.bundled.yaml -o src/generated/schema.d.ts && orval --config orval.config.cjs",
    "typecheck": "tsc --noEmit",
    "test:run": "vitest --run"
  },
  "dependencies": {
    "openapi-fetch": "0.13.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "orval": "7.21.0",
    "typescript": "5.9.3",
    "vitest": "1.6.1"
  }
}
